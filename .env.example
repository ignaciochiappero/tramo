# Tramo environment variables.
#
# Copy this file to .env.local and fill it in:
#   cp .env.example .env.local
# .env.local is git-ignored: never commit real values. docs/setup.md explains
# every step; its step 5 says where each value comes from.

# --- Database -----------------------------------------------------------------
# Local development: start Postgres with `docker compose up -d --wait` and keep
# both lines as they are (compose.yaml uses tramo/tramo/tramo).
# Neon (production): project dashboard -> Connect. DATABASE_URL is the string
# with "Connection pooling" on (its host contains -pooler); DATABASE_URL_UNPOOLED
# is the one with it off.

# Used by the app at runtime.
DATABASE_URL="postgresql://tramo:tramo@localhost:5432/tramo"
# Used only by migrations (pnpm db:migrate).
DATABASE_URL_UNPOOLED="postgresql://tramo:tramo@localhost:5432/tramo"

# --- Better Auth --------------------------------------------------------------
# Signs sessions. Generate a new one for each environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# The exact address you open in the browser, with no trailing slash. It must
# match an origin registered in the Google client below.
# Local: http://localhost:3000    Production: https://your-project.vercel.app
BETTER_AUTH_URL="http://localhost:3000"

# --- Google sign-in -----------------------------------------------------------
# Google Cloud console -> Google Auth Platform -> Clients -> Create client ->
# Web application (docs/setup.md, step 4), with:
#   Authorized JavaScript origin: http://localhost:3000
#   Authorized redirect URI:      http://localhost:3000/api/auth/callback/google
# Add the production origin and redirect URI when you deploy.

# Ends in .apps.googleusercontent.com
GOOGLE_CLIENT_ID=""
# Starts with GOCSPX-. Google shows it only once: save it when you create it.
GOOGLE_CLIENT_SECRET=""

# --- Access -------------------------------------------------------------------
# Comma-separated Google emails that enter as workspace admins. The first of
# them to sign in creates the workspace. Spaces and capitals don't matter.
# Everyone else is invited from Admin -> Members, or waits for approval.
ADMIN_EMAILS="you@example.com, teammate@example.com"
